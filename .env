# ============================================================
# SERVER
# ============================================================



PORT=5000
BASE_URL=http://localhost:5000/
NODE_ENV=development

# ============================================================
# DATABASE
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bulk_calling_system

# ============================================================
# FRONTEND / CORS
# ============================================================
FRONTEND_URL=https://aicallbd.com
MASTER_KEY=fb107e5f3719219530a7e9ca73107c10f25c030df12d05f6a7fdcd6d4c80692f
# ============================================================
# JWT  (rotate this — it was exposed!)
# ============================================================
JWT_SECRET=6a4e5f9f78613d808bcb1740121fac9665afa4f10d46d3017058deae112b587b72d686bc48aafa80cd794c0d4618225d5a3a170f6bb95be9e0875878af2a5c9a
JWT_EXPIRES_IN=7d

# ============================================================
# OTP / VERIFICATION  (NEW — for email/phone verify + reset)
# ============================================================
# Use a DIFFERENT secret than JWT_SECRET in production
OTP_SECRET=change-this-to-another-long-random-string-in-production
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ============================================================
# EMAIL (Nodemailer)  — used for verification + password reset
# ============================================================
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=test@aicallbd.com
SMTP_PASS=z97@S(IpA07zLo
MAIL_FROM="AI Call BD <no-reply@aicallbd.com>"
MAIL_DISABLED=true

IPCALL_BASE_URL=https://ipcall.bd/voiceapi

# ============================================================
# BKASH (existing)
# ============================================================

BKASH_CALLBACK_URL=https://aicallbd.com/api/wallet/bkash/callback
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=4f6o0cjiki2rfm34kfdadl1eqq
BKASH_APP_SECRET=2is7hdktrekvrbljjh44ll3d9l1dtjo4pasmjvs5vl5qr3fug4b
BKASH_USERNAME=sandboxTokenizedUser02
BKASH_PASSWORD=sandboxTokenizedUser02@12345

# ============================================================
# APPLICATION BEHAVIOR
# ============================================================

USE_DEMO_MODE=true
MAX_GLOBAL_CONCURRENT_CALLS=1000
CALL_RETRY_LIMIT=1

# ============================================================
# SUPER ADMIN
# ============================================================
SUPER_ADMIN_EMAIL=test@aicallbd.com


